{
  "name": "darkhollow",
  "version": "1.7.0",
  "private": true,
  "description": "Depths of Darkhollow — A Roguelike Dungeon Crawler",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:preview": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis dir",
    "dist:portable": "npm run build && electron-builder --win portable",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "build": {
    "appId": "com.darkhollow.game",
    "productName": "Depths of Darkhollow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/steamworks.js/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@napi-rs/canvas": "^1.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^15.0.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
