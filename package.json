{
  "name": "darkhollow",
  "version": "1.0.0",
  "private": true,
  "description": "Depths of Darkhollow — A Roguelike Dungeon Crawler",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:preview": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.darkhollow.game",
    "productName": "Depths of Darkhollow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
